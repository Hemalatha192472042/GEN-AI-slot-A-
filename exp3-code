import pandas as pd

data = {
    "Name": ["Ravi", "Priya", "John", "Meena"],
    "Marks": [85, None, 92, 78]
}

df = pd.DataFrame(data)

print("Original Dataset")
print(df)

df["Marks"] = df["Marks"].fillna(df["Marks"].mean())

print("\nCleaned Dataset")
print(df)

print("\nAverage Marks:", df["Marks"].mean())

print("Highest Marks:", df["Marks"].max())
